---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---

<Base title="Vielen Dank" description="Ihre Anfrage ist angekommen." noindex>
  <section class="flex min-h-[80svh] items-center pt-(--header-h)">
    <div class="container-page max-w-3xl text-center">
      <p class="label text-sand-700">Anfrage erhalten</p>
      <h1 class="mt-6 text-display">Vielen Dank. <em class="text-petrol-500">Ich melde mich.</em></h1>
      <p class="mx-auto mt-8 max-w-xl text-lead text-ink-600">Ihre Anfrage ist bei mir angekommen. Innerhalb von 24 Stunden rufe ich Sie an oder schreibe Ihnen. Bis dahin lohnt sich ein Blick in den Ratgeber.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/ratgeber" class="btn btn-dark">Zum Ratgeber <Arrow /></a>
        <a href="/" class="btn btn-ghost">Zur Startseite</a>
      </div>
    </div>
  </section>
</Base>
