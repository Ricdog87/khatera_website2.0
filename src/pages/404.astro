---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---

<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht mehr." noindex>
  <section class="flex min-h-[80svh] items-center pt-(--header-h)">
    <div class="container-page max-w-3xl text-center">
      <p class="label text-olive-700">404</p>
      <h1 class="mt-6 text-display">Dieser Raum ist <em class="text-olive-600">noch leer.</em></h1>
      <p class="mx-auto mt-8 max-w-xl text-lead text-ink-600">Die Seite gibt es nicht oder nicht mehr. Vielleicht finden Sie hier, was Sie suchen.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-dark">Startseite <Arrow /></a>
        <a href="/home-staging-kosten" class="btn btn-ghost">Pakete & Preise</a>
      </div>
    </div>
  </section>
</Base>
