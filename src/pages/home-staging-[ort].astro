---
import { ogBild } from '../lib/og';
import Base from '../layouts/Base.astro';
import Kurzantwort from '../components/Kurzantwort.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import SectionHead from '../components/SectionHead.astro';
import Pakete from '../components/Pakete.astro';
import Ablauf from '../components/Ablauf.astro';
import Regionen from '../components/Regionen.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, orte, pakete, type Ort } from '../config/site';
import { faqAllgemein, faqSchema, type Frage } from '../content/faq';

import wohnEss from '../assets/images/haus-fernblick/home-staging-offener-wohn-essbereich.jpg';
import terrasse from '../assets/images/haus-fernblick/terrasse-fernblick.jpg';
import wohnzimmer from '../assets/images/haus-fernblick/home-staging-wohnzimmer-haus-fernblick.jpg';
import kueche from '../assets/images/haus-fernblick/home-staging-kueche-blick-essbereich.jpg';
import loft from '../assets/images/loft/home-staging-loft-wohnbereich.jpg';
import schlafen from '../assets/images/haus-fernblick/home-staging-schlafzimmer-hell.jpg';
import leseecke from '../assets/images/haus-fernblick/home-staging-leseecke-arbeitszimmer.jpg';
import sofa from '../assets/images/haus-fernblick/detail-sofa-plaid.jpg';

export function getStaticPaths() {
  return orte.map((ort) => ({ params: { ort: ort.slug }, props: { ort } }));
}

const { ort } = Astro.props as { ort: Ort };
const bilder = { wiesbaden: wohnEss, rheingau: terrasse, taunusstein: wohnzimmer, mainz: kueche, frankfurt: loft, darmstadt: leseecke, offenbach: schlafen, 'bad-homburg': sofa } as const;
const bild = bilder[ort.slug as keyof typeof bilder] ?? wohnEss;

const fragen: Frage[] = [
  {
    frage: `Was kostet Home Staging ${ort.praep}?`,
    antwort: `Das hängt von Ihrer Immobilie ab: von der Zahl der Räume, der Preisklasse, der Laufzeit der Möbelmiete und dem Aufwand beim Auf- und Abbau. Deshalb gibt es keine Preisliste, sondern nach einem kostenlosen Erstgespräch ein persönliches Angebot innerhalb von 48 Stunden. Die Anfahrt ${ort.praep} ist enthalten.`,
  },
  {
    frage: `Wie schnell sind Sie ${ort.praep} vor Ort?`,
    antwort: `${ort.anfahrt} Vom Auftrag bis zur fertig eingerichteten Immobilie vergehen meist ein bis zwei Wochen.`,
  },
  {
    frage: `In welchen Lagen ${ort.praep} sind Sie tätig?`,
    antwort: `Überall ${ort.praep} und Umgebung, unter anderem in ${ort.lagen.slice(0, -1).join(', ')} und ${ort.lagen.at(-1)}.`,
  },
  faqAllgemein[1],
  faqAllgemein[3],
  faqAllgemein[4],
];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: ort.title,
  serviceType: 'Home Staging',
  provider: { '@id': `${Astro.site!.href.replace(/\/$/, '')}/#business` },
  areaServed: { '@type': 'Place', name: ort.name },
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Home Staging Pakete', itemListElement: pakete.map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: p.name, description: p.fuer } })) },
};
const og = await ogBild(bild);
---

<Base
  ogImage={og}
  title={`${ort.title} | Khatera Gross`}
  description={ort.description}
  schema={[service, faqSchema(fragen)]}
  breadcrumbs={[{ name: ort.title, href: `/home-staging-${ort.slug}` }]}
>
  <section class="pt-10 pb-[var(--section)] md:pt-16">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <p class="label rule text-olive-700" data-reveal>Home Staging · {ort.name}</p>
        <h1 class="mt-6 text-display" data-reveal style="--d:1">Home Staging <em class="text-olive-600">{ort.praep}</em></h1>
        <p class="mt-8 text-lead text-ink-600" data-reveal style="--d:2">{ort.intro}</p>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--d:3">
          <a href={`/kontakt?ort=${encodeURIComponent(ort.name)}`} class="btn btn-primary">Angebot anfragen <Arrow /></a>
          <a href={company.phoneHref} class="btn btn-ghost lining-nums">{company.phone}</a>
        </div>
      </div>
      <div class="lg:col-span-6">
        <div class="overflow-hidden" data-reveal="image">
          <Photo src={bild} alt={`Home Staging ${ort.praep}: inszenierter Wohnraum von Khatera Gross`} widths={[768, 1080, 1440, 1920]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <Kurzantwort
    class="mb-[var(--section)]"
    frage={`Wer bietet Home Staging ${ort.praep} an?`}
    antwort={`Khatera Gross Home Staging aus Taunusstein inszeniert Immobilien ${ort.praep} und im gesamten Rhein-Main-Gebiet, unter anderem in ${ort.lagen.slice(0, 4).join(', ')}. ${ort.anfahrt} Zur Wahl stehen Staging-Beratung für bewohnte Immobilien, Teil-Staging und Komplett-Staging, jeweils inklusive Möbelmiete und Anfahrt. Nach einem kostenlosen Erstgespräch gibt es innerhalb von 48 Stunden ein persönliches Angebot.`}
    fakten={[
      { label: 'Region', wert: ort.name },
      { label: 'Erstgespräch', wert: 'kostenlos' },
      { label: 'Aufbau', wert: 'meist 1 Tag' },
      { label: 'Angebot', wert: 'individuell, in 48 Std.' },
    ]}
  />

  <section class="section bg-linen">
    <div class="container-page grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHead label={`Immobilienmarkt ${ort.name}`} title="Warum sich Home Staging" em={`${ort.praep} lohnt.`} />
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <div class="space-y-5 text-[1.125rem] text-ink-600" data-reveal>
          {ort.markt.map((m) => <p>{m}</p>)}
        </div>
        <p class="label mt-12 text-olive-700" data-reveal>Hier bin ich unterwegs</p>
        <ul class="mt-4 flex flex-wrap gap-2" data-reveal>
          {ort.lagen.map((l) => <li class="rounded-full border border-ink-900/15 px-4 py-2 text-small">{l}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <SectionHead label="Pakete" title={`Pakete für ${ort.name}.`} em="Individuell abgestimmt." />
      <div class="mt-16">
        <Pakete />
      </div>
      <p class="mt-8 text-small text-ink-600">Den Preis besprechen wir individuell, die Anfahrt {ort.praep} ist enthalten. <a href="/home-staging-kosten" class="link-line text-ink-900">Alles zu Paketen und Ablauf</a></p>
    </div>
  </section>

  <Ablauf />
  <Faq fragen={fragen} title={`Home Staging ${ort.praep}:`} em="Ihre Fragen." />
  <Regionen exclude={ort.slug} />
  <CtaBand title={`Verkaufen ${ort.praep}?`} em="Ich inszeniere Ihre Immobilie." />
</Base>
