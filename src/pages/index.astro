---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import SectionHead from '../components/SectionHead.astro';
import Pakete from '../components/Pakete.astro';
import Ablauf from '../components/Ablauf.astro';
import Rechner from '../components/Rechner.astro';
import Regionen from '../components/Regionen.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { extras, facts } from '../config/site';
import { faqAllgemein, faqSchema } from '../content/faq';

import hero from '../assets/images/haus-fernblick/home-staging-wohnzimmer-haus-fernblick.jpg';
import portrait from '../assets/images/portrait/khatera-gross-portrait-business.jpg';
import wohnEssbereich from '../assets/images/haus-fernblick/home-staging-offener-wohn-essbereich.jpg';
import kueche from '../assets/images/haus-fernblick/home-staging-kueche-blick-essbereich.jpg';
import konsole from '../assets/images/haus-fernblick/detail-konsole-vase.jpg';
import sofaDetail from '../assets/images/haus-fernblick/detail-sofa-plaid.jpg';
import detail from '../assets/images/haus-fernblick/detail-kissen-kerzen.jpg';

const zielgruppen = [
  {
    titel: 'Eigentümer',
    text: 'Sie verkaufen Ihr Haus oder Ihre Wohnung und wollen keinen Euro verschenken. Ich mache aus leeren oder vollgestellten Räumen ein Zuhause, in das sich Käufer verlieben.',
    link: '/home-staging',
    cta: 'Home Staging',
  },
  {
    titel: 'Makler',
    text: 'Bessere Exposéfotos, mehr Anfragen, kürzere Vermarktung. Mit mir als fester Staging-Partnerin gewinnen Sie Aufträge und schließen schneller ab.',
    link: '/makler-bautraeger',
    cta: 'Partnermodell',
  },
  {
    titel: 'Bauträger',
    text: 'Musterwohnungen und Restanten, die Grundrisse verständlich machen. Real, virtuell oder kombiniert, abgestimmt auf Ihre Vertriebsphase.',
    link: '/musterwohnungen',
    cta: 'Musterwohnungen',
  },
  {
    titel: 'Investoren',
    text: 'Fix & Flip: Saniert, aber leer? Ich mache Ihr Objekt in wenigen Tagen verkaufsfertig, damit das Kapital schnell wieder frei wird.',
    link: '/fix-and-flip',
    cta: 'Fix & Flip',
  },
];
---

<Base
  title="Home Staging im Rheingau, Wiesbaden & Taunusstein | Khatera Gross"
  description="Home Staging von Khatera Gross: Immobilien schneller und zum besseren Preis verkaufen. Pakete ab 290 € für Eigentümer, Makler und Bauträger im Rheingau, in Wiesbaden, Mainz und Frankfurt."
  overlayHeader
  schema={[faqSchema(faqAllgemein)]}
>
  <!-- Hero -->
  <section class="on-dark relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-ink-900 text-paper">
    <div class="absolute inset-0 -z-10 overflow-hidden" data-parallax-frame>
      <Photo src={hero} alt="Von Khatera Gross inszeniertes, lichtdurchflutetes Wohnzimmer mit cremefarbenem Sofa und Blick ins Grüne" widths={[768, 1080, 1440, 1920, 2600]} sizes="100vw" loading="eager" fetchpriority="high" class="hero-img h-full w-full object-cover object-[55%_50%]" data-parallax="0.1" />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(30_30_29/0.45)_0%,rgb(30_30_29/0)_28%,rgb(30_30_29/0.12)_55%,rgb(30_30_29/0.78)_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(30_30_29/0.55)_0%,rgb(30_30_29/0.12)_50%,transparent_75%)]"></div>
    </div>

    <div class="container-page pt-[calc(var(--header-h)+3rem)] pb-10 md:pb-14">
      <p class="label rule text-paper/85" data-reveal>Home Staging · Rheingau · Wiesbaden · Taunus</p>
      <h1 class="mt-6 max-w-[14ch] text-hero" data-reveal style="--d:1">Räume, die <em class="text-sand-400">verkaufen.</em></h1>
      <div class="mt-8 grid gap-8 md:grid-cols-12 md:items-end">
        <p class="max-w-xl text-lead text-paper/85 md:col-span-6" data-reveal style="--d:2">
          Ich inszeniere Häuser und Wohnungen so, dass Käufer sich sofort zu Hause fühlen. Für schnellere Verkäufe, stärkere Exposés und bessere Preise.
        </p>
        <div class="flex flex-wrap gap-3 md:col-span-6 md:justify-end" data-reveal style="--d:3">
          <a href="/home-staging-kosten" class="btn btn-light">Pakete & Preise <Arrow /></a>
          <a href="#rechner" class="btn btn-ghost">Mehrerlös berechnen</a>
        </div>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-white/20 pt-6 text-small text-paper/80 md:mt-16 md:grid-cols-4" data-reveal style="--d:4">
        <li><span class="text-sand-400">✦</span> Festpreis in 48 Stunden</li>
        <li><span class="text-sand-400">✦</span> Aufbau meist an einem Tag</li>
        <li><span class="text-sand-400">✦</span> Abbau nach dem Notartermin</li>
        <li><span class="text-sand-400">✦</span> Premium-Mitglied Staging Community</li>
      </ul>
    </div>
  </section>

  <!-- Haltung -->
  <section class="section">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="label rule text-olive-700" data-reveal>Warum Home Staging</p>
        <p class="mt-8 font-display text-[clamp(1.875rem,1.3rem+2.4vw,3.5rem)] leading-[1.12] tracking-[-0.01em]" data-reveal style="--d:1">
          Käufer entscheiden in Sekunden, nicht in Quadratmetern. Leere Räume wirken kleiner, kälter und schwer vorstellbar. <em class="text-olive-600">Ich gebe ihnen ein Gefühl von Zuhause</em> &mdash; schon auf dem ersten Foto im Exposé.
        </p>
        <div class="mt-12 grid gap-8 border-t border-line pt-10 sm:grid-cols-3">
          {facts.map((f, i) => (
            <div data-reveal style={`--d:${i}`}>
              <p class="font-display text-[3.5rem] leading-none text-olive-600 lining-nums"><span data-count={f.value}>{f.value}</span>{f.unit}</p>
              <p class="mt-3 text-small text-ink-600">{f.label}</p>
            </div>
          ))}
        </div>
      </div>
      <figure class="relative lg:col-span-4 lg:col-start-9">
        <div class="overflow-hidden" data-reveal="image">
          <Photo src={portrait} alt="Khatera Gross, Home Stagerin aus Taunusstein, im dunkelblauen Blazer" widths={[480, 768, 964]} sizes="(min-width: 1024px) 30vw, 90vw" class="aspect-[4/5] w-full object-cover object-[50%_25%]" />
        </div>
        <figcaption class="mt-4 flex items-baseline justify-between text-small text-ink-600">
          <span class="font-display text-[1.5rem] italic text-ink-900">Khatera Gross</span>
          <span>Gründerin</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Zielgruppen -->
  <section class="section pt-0">
    <div class="container-page">
      <div class="grid gap-px border border-line bg-line md:grid-cols-2 xl:grid-cols-4">
        {zielgruppen.map((z, i) => (
          <a href={z.link} class="group flex flex-col bg-paper p-8 transition-colors duration-500 hover:bg-linen md:p-10" data-reveal style={`--d:${i}`}>
            <p class="label text-olive-700">Für</p>
            <h2 class="mt-3 text-headline">{z.titel}</h2>
            <p class="mt-6 flex-1 text-ink-600">{z.text}</p>
            <span class="label mt-10 inline-flex items-center gap-3 text-ink-900">{z.cta} <Arrow class="h-3 w-4 transition-transform duration-500 group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Pakete -->
  <section class="section kg-muster bg-linen" id="leistungen">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <SectionHead class="lg:col-span-7" label="Pakete" title="Klare Pakete." em="Klare Preise." />
        <p class="text-lead text-ink-600 lg:col-span-4 lg:col-start-9" data-reveal>Wählen Sie das passende Paket, ich melde mich innerhalb von 24 Stunden mit einem Terminvorschlag.</p>
      </div>
      <div class="mt-16 md:mt-20">
        <Pakete />
      </div>
      <div class="mt-16 grid gap-8 border-t border-ink-900/15 pt-10 md:grid-cols-2 xl:grid-cols-4">
        {extras.map((e, i) => (
          <div data-reveal style={`--d:${i}`}>
            <p class="label text-olive-700">Extra</p>
            <h3 class="mt-3 font-display text-[1.625rem] leading-tight">{e.name}</h3>
            <p class="mt-2 text-small text-ink-600">{e.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-12" data-reveal><a href="/home-staging-kosten" class="label link-line text-ink-900">Alle Details zu Kosten und Leistungen</a></p>
    </div>
  </section>

  <!-- Projekte -->
  <section class="section overflow-hidden">
    <div class="container-page">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <SectionHead label="Einblicke" title="Weniger Möbel." em="Mehr Wirkung." />
        <a href="/projekte" class="btn btn-ghost self-start md:self-auto" data-reveal>Alle Projekte <Arrow /></a>
      </div>

      <div class="mt-16 grid grid-cols-12 gap-3 md:gap-5">
        <figure class="col-span-12 md:col-span-8">
          <div class="overflow-hidden" data-reveal="image"><Photo src={wohnEssbereich} alt="Offener Wohn- und Essbereich mit ovalem Esstisch, Glasbausteinwand und Blick in den Garten" widths={[768, 1440, 2600]} sizes="(min-width: 768px) 66vw, 100vw" class="aspect-[3/2] w-full object-cover" /></div>
          <figcaption class="mt-3 flex justify-between text-small text-ink-600"><span>Wohn- und Essbereich, Haus mit Fernblick</span><span>Komplett-Staging</span></figcaption>
        </figure>
        <figure class="col-span-6 md:col-span-4 md:mt-24">
          <div class="overflow-hidden" data-reveal="image"><Photo src={konsole} alt="Konsole mit Vase, Skulptur und Kunstdruck" widths={[480, 768, 1080]} sizes="(min-width: 768px) 33vw, 50vw" class="aspect-[3/4] w-full object-cover object-[18%_50%]" /></div>
          <figcaption class="mt-3 text-small text-ink-600">Detail, Flur</figcaption>
        </figure>
        <figure class="col-span-6 md:col-span-4 md:-mt-20">
          <div class="overflow-hidden" data-reveal="image"><Photo src={sofaDetail} alt="Sofa mit Strickplaid, Kissen und Tischleuchte am Fenster" widths={[480, 768, 1080]} sizes="(min-width: 768px) 33vw, 50vw" class="aspect-[3/4] w-full object-cover object-[60%_50%]" /></div>
          <figcaption class="mt-3 text-small text-ink-600">Detail, Wohnzimmer</figcaption>
        </figure>
        <figure class="col-span-12 md:col-span-8">
          <div class="overflow-hidden" data-reveal="image"><Photo src={kueche} alt="Küchenzeile mit Pendelleuchten und Blick in den Essbereich" widths={[768, 1440, 2600]} sizes="(min-width: 768px) 66vw, 100vw" class="aspect-[3/2] w-full object-cover" /></div>
          <figcaption class="mt-3 flex justify-between text-small text-ink-600"><span>Küche, Haus mit Fernblick</span><span>Komplett-Staging</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <Ablauf />
  <Rechner />

  <!-- Über -->
  <section class="section">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:items-center">
      <div class="relative lg:col-span-5">
        <div class="overflow-hidden" data-reveal="image">
          <Photo src={detail} alt="Detail einer Inszenierung: Kissen, Kerzen und Sukkulente auf dem Sofa" widths={[768, 1080, 1440]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/5] w-full object-cover object-[40%_50%]" />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <SectionHead label="Über mich" title="Mit Leidenschaft inszeniert," em="mit Liebe zum Detail." />
        <div class="mt-8 space-y-5 text-ink-600" data-reveal style="--d:2">
          <p>Ich bin Khatera Gross, Gründerin von Khatera Gross Home Staging in Taunusstein. Meine Leidenschaft gilt Räumen, die Menschen berühren: Licht, Proportion, Material und das eine Detail, das hängen bleibt.</p>
          <p>Ein Immobilienverkauf ist mehr als eine Transaktion. Ich begleite Sie von der ersten Idee bis zum Notartermin und sorge dafür, dass Ihre Immobilie nicht nur heraussticht, sondern schnell und zu einem guten Preis verkauft wird.</p>
          <p>Als <strong class="font-normal text-ink-900">Premium-Mitglied der Staging Community</strong>, dem größten Netzwerk von über 250 Home-Staging-Profis im deutschsprachigen Raum, arbeite ich nach festen Qualitätsstandards und bilde mich laufend weiter.</p>
        </div>
        <a href="/ueber-mich" class="btn btn-dark mt-10" data-reveal>Mehr über mich <Arrow /></a>
      </div>
    </div>
  </section>

  <Regionen />
  <Faq fragen={faqAllgemein} />
  <CtaBand />
</Base>
