---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqSchema, type Frage } from '../content/faq';
import wohnEss from '../assets/images/haus-fernblick/home-staging-offener-wohn-essbereich.jpg';
import esstisch from '../assets/images/haus-fernblick/detail-esstisch.jpg';

const vorteile = [
  { titel: 'Mehr Mandate gewinnen', text: 'Home Staging als Teil Ihres Leistungsversprechens überzeugt Eigentümer im Akquisegespräch. Sie bieten mehr als die Konkurrenz.' },
  { titel: 'Stärkere Exposés', text: 'Inszenierte Räume liefern Fotos, die auf den Portalen auffallen. Mehr Klicks, mehr Anfragen, bessere Besichtigungen.' },
  { titel: 'Kürzere Vermarktung', text: 'Weniger Besichtigungen, weniger Preisdiskussionen, schnellerer Abschluss. Ihre Provision kommt früher.' },
];

const partner = [
  'Feste Partnerkonditionen für alle Pakete',
  'Kostenbeteiligung möglich: Partner können bis zu 50 % der Staging-Kosten für ihre Eigentümer übernehmen',
  'Priorisierte Termine, auch kurzfristig vor dem Fototermin',
  'Ein Ansprechpartner, ein Ablauf, kein Abstimmungsaufwand',
  'Unterlagen für Ihr Akquisegespräch mit Eigentümern',
  'Abrechnung wahlweise über Sie oder direkt mit dem Eigentümer',
];

const fragen: Frage[] = [
  { frage: 'Wie funktioniert die Zusammenarbeit mit Maklern?', antwort: 'Sie melden ein Objekt, ich schaue mir Grundriss und Fotos an und schicke innerhalb von 48 Stunden ein Festpreisangebot. Auf Wunsch spreche ich direkt mit dem Eigentümer. Aufbau meist an einem Tag, damit Ihr Fototermin fest geplant werden kann.' },
  { frage: 'Wer ist Vertragspartner, Makler oder Eigentümer?', antwort: 'Beides ist möglich. Viele Makler beauftragen das Staging selbst und kalkulieren es in ihre Vermarktung ein, andere vermitteln den Auftrag und ich rechne direkt mit dem Eigentümer ab. Als Partner können Sie bis zu 50 % der Kosten für Ihre Eigentümer übernehmen.' },
  { frage: 'Können Sie auch mehrere Objekte parallel betreuen?', antwort: 'Ja. Für Partner plane ich Kapazitäten fest ein. Sprechen Sie mich frühzeitig an, dann sichern wir die Termine.' },
];
---

<Base
  title="Home Staging für Makler: Partnermodell"
  description="Home Staging als Vertriebswerkzeug für Immobilienmakler im Rhein-Main-Gebiet: feste Partnerkonditionen, Kostenbeteiligung bis 50 %, Aufbau meist an einem Tag. Mehr Mandate, schnellere Abschlüsse."
  breadcrumbs={[{ name: 'Für Makler', href: '/makler-bautraeger' }]}
  schema={[faqSchema(fragen)]}
>
  <section class="pt-10 pb-[var(--section)] md:pt-16">
    <div class="container-page grid gap-14 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label rule text-olive-700" data-reveal>Für Makler</p>
        <h1 class="mt-6 text-display" data-reveal style="--d:1">Ihr Vertrieb verdient <em class="text-olive-600">eine Bühne.</em></h1>
        <p class="mt-10 max-w-2xl text-lead text-ink-600" data-reveal style="--d:2">Ich bin Ihre feste Staging-Partnerin im Rhein-Main-Gebiet. Für Makler, die mehr Mandate gewinnen, bessere Exposés liefern und schneller abschließen wollen.</p>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--d:3">
          <a href="/kontakt?paket=makler" class="btn btn-primary">Partnergespräch vereinbaren <Arrow /></a>
          <a href="/musterwohnungen" class="btn btn-ghost">Für Bauträger</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="overflow-hidden" data-reveal="image">
          <Photo src={wohnEss} alt="Offener Wohn- und Essbereich nach dem Home Staging" widths={[768, 1080, 1440]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" class="aspect-[4/5] w-full object-cover object-[45%_50%]" />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-linen">
    <div class="container-page">
      <SectionHead label="Ihr Vorteil" title="Home Staging ist Ihr" em="Argument im Akquisegespräch." />
      <div class="mt-14 grid gap-px border border-ink-900/10 bg-ink-900/10 md:grid-cols-3">
        {vorteile.map((v, i) => (
          <div class="bg-linen p-8 md:p-10" data-reveal style={`--d:${i}`}>
            <p class="font-display text-[3rem] leading-none text-olive-700 italic lining-nums">0{i + 1}</p>
            <h3 class="mt-6 text-title">{v.titel}</h3>
            <p class="mt-4 text-ink-600">{v.text}</p>
          </div>
        ))}
      </div>

      <div class="on-dark mt-16 grid gap-10 bg-graphit-800 p-8 text-paper md:p-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-sand-400">Partnermodell</p>
          <h3 class="mt-4 text-headline">Ein Anruf. <em class="text-sand-400">Alles erledigt.</em></h3>
          <div class="mt-10 hidden overflow-hidden lg:block">
            <Photo src={esstisch} alt="Detail: gedeckter Esstisch mit Vase und Kerze" widths={[480, 768, 1080]} sizes="35vw" class="aspect-[4/3] w-full object-cover" />
          </div>
        </div>
        <ul class="space-y-4 lg:col-span-6 lg:col-start-7">
          {partner.map((p) => (
            <li class="flex gap-4 border-b border-white/15 pb-4">
              <svg class="mt-[0.45em] h-3 w-3 shrink-0 text-sand-400" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6.5 4.5 10 11 2" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
              <span>{p}</span>
            </li>
          ))}
          <li class="pt-4"><a href="/kontakt?paket=makler" class="btn btn-light">Konditionen anfragen <Arrow /></a></li>
        </ul>
      </div>
    </div>
  </section>

  <Faq fragen={fragen} title="Fragen von" em="Maklern." />
  <CtaBand title="Lassen Sie uns" em="gemeinsam verkaufen." text="Ein kurzes Gespräch genügt, um zu sehen, ob wir zusammenpassen. Ich freue mich auf Ihren Anruf." />
</Base>
