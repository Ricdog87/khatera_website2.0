---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';

const artikel = (await getCollection('ratgeber')).sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
const datum = (d: Date) => d.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
---

<Base
  title="Home Staging Ratgeber: Tipps, Kosten, Begriffe"
  description="Der Home Staging Ratgeber von Khatera Gross: Was Home Staging ist, was es bringt, Tipps für den Verkauf und alle Fachbegriffe einfach erklärt."
  breadcrumbs={[{ name: 'Ratgeber', href: '/ratgeber' }]}
>
  <section class="pt-10 pb-[var(--section)] md:pt-16">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="label rule text-sand-700" data-reveal>Ratgeber</p>
          <h1 class="mt-6 text-display" data-reveal style="--d:1">Alles über <em class="text-petrol-500">Home Staging.</em></h1>
        </div>
        <p class="text-lead text-ink-600 lg:col-span-4" data-reveal style="--d:2">Wissen, Tipps und ehrliche Antworten für alle, die eine Immobilie verkaufen oder vermarkten.</p>
      </div>

      <div class="mt-16 grid gap-x-6 gap-y-16 md:grid-cols-2">
        {artikel.map((a, i) => (
          <a href={`/ratgeber/${a.id}`} class="group block" data-reveal style={`--d:${i % 2}`}>
            <div class="overflow-hidden">
              <Photo src={a.data.bild} alt={a.data.bildAlt} widths={[480, 768, 1080]} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-[3/2] w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-expo)] group-hover:scale-[1.04]" />
            </div>
            <p class="label mt-6 text-sand-700">{a.data.kategorie} · {a.data.lesezeit} Min. · {datum(a.data.datum)}</p>
            <h2 class="mt-3 text-title">{a.data.title}</h2>
            <p class="mt-3 max-w-xl text-ink-600">{a.data.description}</p>
            <span class="label mt-6 inline-flex items-center gap-3">Lesen <Arrow class="h-3 w-4 transition-transform duration-500 group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
