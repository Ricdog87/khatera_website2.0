---
import { ogBild } from '../lib/og';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import GoogleBewertung from '../components/GoogleBewertung.astro';

import hfWohnen from '../assets/images/haus-fernblick/home-staging-wohnzimmer-haus-fernblick.jpg';
import hfWohnEss from '../assets/images/haus-fernblick/home-staging-offener-wohn-essbereich.jpg';
import hfKueche from '../assets/images/haus-fernblick/home-staging-kueche-blick-essbereich.jpg';
import hfSchlafen from '../assets/images/haus-fernblick/home-staging-schlafzimmer-hell.jpg';
import hfAnkleide from '../assets/images/haus-fernblick/home-staging-ankleidezimmer.jpg';
import hfSofa from '../assets/images/haus-fernblick/detail-sofa-plaid.jpg';
import hfKonsole from '../assets/images/haus-fernblick/detail-konsole-vase.jpg';
import hfTerrasse from '../assets/images/haus-fernblick/terrasse-fernblick.jpg';
import wtWohnen from '../assets/images/haus-wendeltreppe/home-staging-wohnzimmer-hell.jpg';
import wtEssen from '../assets/images/haus-wendeltreppe/home-staging-essbereich-kueche.jpg';
import wtDiele from '../assets/images/haus-wendeltreppe/home-staging-diele-wendeltreppe.jpg';
import wtTreppe from '../assets/images/haus-wendeltreppe/detail-wendeltreppe-gelaender.jpg';
import wtSchlafen from '../assets/images/haus-wendeltreppe/home-staging-schlafzimmer-balkon.jpg';
import wtKinder from '../assets/images/haus-wendeltreppe/home-staging-kinderzimmer-hausbett.jpg';
import bhWohnen from '../assets/images/bodenheim/home-staging-wohnzimmer-bodenheim.jpg';
import bhSessel from '../assets/images/bodenheim/home-staging-wohnzimmer-regal-sessel.jpg';
import bhKonsole from '../assets/images/bodenheim/detail-konsole-kunstdrucke.jpg';
import bhSchlafen from '../assets/images/bodenheim/home-staging-schlafzimmer-bodenheim.jpg';
import bhArbeit from '../assets/images/bodenheim/home-staging-schlafzimmer-arbeitsplatz.jpg';
import bhBad from '../assets/images/bodenheim/home-staging-bad-bodenheim.jpg';
import loftWohnen from '../assets/images/loft/home-staging-loft-wohnbereich.jpg';
import loftTreppe from '../assets/images/loft/home-staging-loft-treppe.jpg';
import nbWohnen from '../assets/images/projekte/home-staging-wohnzimmer-neubauwohnung.jpg';
import nbKonsole from '../assets/images/projekte/home-staging-wohnzimmer-detail-konsole.jpg';
import elQuer from '../assets/images/projekte/einliegerwohnung-schlafzimmer-quer.jpg';
import elVase from '../assets/images/projekte/einliegerwohnung-konsole-vase.jpg';

// TODO Kundin: Orte, Flächen und Ergebnisse (z. B. "nach 3 Wochen reserviert") ergänzen
const projekte = [
  {
    nr: '01',
    titel: 'Haus mit Fernblick',
    ort: 'Rhein-Main',
    art: 'Komplett-Staging',
    text: 'Ein großzügiges Einfamilienhaus mit offenem Grundriss, Glasbausteinwand und Blick über die Felder. Helle Naturtöne, Bouclé, Leinen und schwarze Akzente machen aus den leeren Räumen ein ruhiges, hochwertiges Zuhause, das die Weite des Hauses betont.',
    bilder: [
      { src: hfWohnen, alt: 'Wohnzimmer mit cremefarbenem Sofa, Leinenvorhängen und Blick auf die Terrasse', cls: 'col-span-12', ratio: 'aspect-[3/2]' },
      { src: hfWohnEss, alt: 'Offener Wohn- und Essbereich mit ovalem Esstisch und Glasbausteinwand', cls: 'col-span-12 md:col-span-7', ratio: 'aspect-[3/2]' },
      { src: hfSofa, alt: 'Sofa mit Strickplaid und Kissen am Fenster', cls: 'col-span-12 md:col-span-5', ratio: 'aspect-[4/5] md:aspect-auto md:h-full' },
      { src: hfKueche, alt: 'Küchenzeile mit Pendelleuchten und Blick in den Essbereich', cls: 'col-span-12', ratio: 'aspect-[3/2]' },
      { src: hfKonsole, alt: 'Konsole mit Vase, Skulptur und Kunstdruck', cls: 'col-span-6 md:col-span-5', ratio: 'aspect-[3/4] md:aspect-auto md:h-full object-[18%_50%]' },
      { src: hfSchlafen, alt: 'Helles Schlafzimmer mit Tagesdecke und großen Fenstern', cls: 'col-span-6 md:col-span-7', ratio: 'aspect-[3/4] md:aspect-[3/2]' },
      { src: hfAnkleide, alt: 'Ankleidezimmer mit Kleiderstange, Hocker und Teppich', cls: 'col-span-12 md:col-span-6', ratio: 'aspect-[3/2]' },
      { src: hfTerrasse, alt: 'Terrasse mit weitem Blick über Felder und Hügel', cls: 'col-span-12 md:col-span-6', ratio: 'aspect-[3/2]' },
    ],
  },
  {
    nr: '02',
    titel: 'Wohnung in Bodenheim',
    ort: 'Bodenheim, Rheinhessen',
    art: 'Komplett-Staging',
    text: 'Eine frisch renovierte Erdgeschosswohnung, leer und ohne Maßstab auf den Fotos. Rundes Sofa, schwarze Stahlregale, warme Brauntöne und Bouclé geben jedem Raum eine klare Aufgabe: wohnen, essen, schlafen, arbeiten.',
    bilder: [
      { src: bhWohnen, alt: 'Wohnzimmer mit rundem Sofa, Couchtisch aus Holz und schwarzem Regal', cls: 'col-span-12', ratio: 'aspect-[3/2]' },
      { src: bhSessel, alt: 'Sitzecke mit Sessel, Plaid und Stahlregalen, Blick in den Essbereich', cls: 'col-span-12 md:col-span-7', ratio: 'aspect-[3/2]' },
      { src: bhKonsole, alt: 'Konsole mit Kunstdrucken, Vase und Hängepflanze', cls: 'col-span-12 md:col-span-5', ratio: 'aspect-[4/5] md:aspect-auto md:h-full' },
      { src: bhSchlafen, alt: 'Schlafzimmer mit Doppelbett, Holzpaneel, Sitzbank und Pendelleuchte', cls: 'col-span-12', ratio: 'aspect-[3/2]' },
      { src: bhArbeit, alt: 'Schlafzimmer mit Arbeitsplatz, Sessel und Garderobe', cls: 'col-span-6', ratio: 'aspect-[3/2]' },
      { src: bhBad, alt: 'Bad mit Waschtisch, rundem Spiegel und Handtuchhalter', cls: 'col-span-6', ratio: 'aspect-[3/2]' },
    ],
  },
  {
    nr: '03',
    titel: 'Haus mit Wendeltreppe',
    ort: 'Rhein-Main',
    art: 'Komplett-Staging',
    text: 'Ein modernisiertes Einfamilienhaus mit schmiedeeiserner Wendeltreppe, Eichenparkett und viel Licht. Klare Möbel in Weiß, Creme und Schwarz lassen der Architektur den Vortritt, vom offenen Essbereich bis ins Kinderzimmer.',
    bilder: [
      { src: wtWohnen, alt: 'Helles Wohnzimmer mit Sofa, Teppich und Bogenleuchte', cls: 'col-span-12', ratio: 'aspect-[4/3]' },
      { src: wtDiele, alt: 'Diele mit schmiedeeiserner Wendeltreppe und Blick in den Garten', cls: 'col-span-12 md:col-span-7', ratio: 'aspect-[4/3]' },
      { src: wtTreppe, alt: 'Detail des verschnörkelten Treppengeländers von oben', cls: 'col-span-12 md:col-span-5', ratio: 'aspect-[4/5] md:aspect-auto md:h-full' },
      { src: wtEssen, alt: 'Essbereich mit ovalem Tisch und offener Küche', cls: 'col-span-12', ratio: 'aspect-[4/3]' },
      { src: wtSchlafen, alt: 'Schlafzimmer mit Bett, Teppich und Zugang zum Balkon', cls: 'col-span-6', ratio: 'aspect-[4/3]' },
      { src: wtKinder, alt: 'Kinderzimmer mit Hausbett und Spielteppich', cls: 'col-span-6', ratio: 'aspect-[4/3]' },
    ],
  },
  {
    nr: '04',
    titel: 'Loft mit Galerie',
    ort: 'Rhein-Main',
    art: 'Home Staging, Gewerbe zu Wohnen',
    text: 'Ein ehemaliger Gewerberaum mit Galerie und offener Treppe. Mit einer großen Sitzlandschaft, Teppich als Insel und wenigen grafischen Akzenten wird der Raum lesbar: Hier wohnt man, hier arbeitet man, hier kommt man an.',
    bilder: [
      { src: loftWohnen, alt: 'Loft mit Sitzlandschaft, Couchtisch und Glaswand zur Galerie', cls: 'col-span-12', ratio: 'aspect-[3/2]' },
      { src: loftTreppe, alt: 'Offene Stahltreppe zur Galerie im Loft', cls: 'col-span-12', ratio: 'aspect-[3/2]' },
    ],
  },
  {
    nr: '05',
    titel: 'Neubauwohnung',
    ort: 'Rhein-Main',
    art: 'Home Staging, leerstehend',
    text: 'Eine helle Neubauwohnung ohne Charakter auf den Fotos. Mit warmem Licht, ruhigen Naturtönen und klaren Möbelgruppen wurde der offene Grundriss sofort verständlich.',
    bilder: [
      { src: nbWohnen, alt: 'Wohnzimmer mit Pendelleuchte, Regal und Sofa in warmem Licht', cls: 'col-span-12 md:col-span-7', ratio: 'aspect-[3/2]' },
      { src: nbKonsole, alt: 'Konsole mit Skulptur, Leuchte und Kunstdruck', cls: 'col-span-12 md:col-span-5', ratio: 'aspect-[4/5] md:aspect-auto md:h-full' },
    ],
  },
  {
    nr: '06',
    titel: 'Einliegerwohnung',
    ort: 'Rheingau-Taunus',
    art: 'Einrichtung & Styling',
    text: 'Kleine Fläche, große Wirkung: Mit wenigen, gut gewählten Stücken in Creme, Holz und Schwarz wirkt die Einliegerwohnung großzügig und hochwertig.',
    bilder: [
      { src: elQuer, alt: 'Schlafzimmer der Einliegerwohnung mit Pendelleuchte aus Rattan und Teppich', cls: 'col-span-12 md:col-span-8', ratio: 'aspect-[4/3]' },
      { src: elVase, alt: 'Konsole mit Glasvase und Trockenblumen', cls: 'col-span-12 md:col-span-4', ratio: 'aspect-[3/4] md:aspect-auto md:h-full' },
    ],
  },
];
const og = await ogBild(hfWohnen);
---

<Base
  ogImage={og}
  title="Home Staging Projekte & Referenzen"
  description="Ausgewählte Home Staging Projekte von KG Homestaging im Rhein-Main-Gebiet: Haus mit Fernblick, Wohnung in Bodenheim, Haus mit Wendeltreppe und mehr. So wirken inszenierte Räume."
  breadcrumbs={[{ name: 'Projekte', href: '/projekte' }]}
>
  <section class="pt-10 pb-[calc(var(--section)*0.6)] md:pt-16">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="label rule text-olive-700" data-reveal>Projekte</p>
        <h1 class="mt-6 text-display" data-reveal style="--d:1">Räume, die man <em class="text-olive-600">kaufen möchte.</em></h1>
      </div>
      <div class="lg:col-span-4" data-reveal style="--d:2">
        <p class="text-lead text-ink-600">Jede Immobilie bekommt ihr eigenes Konzept. Hier ein Einblick in aktuelle Inszenierungen.</p>
        <GoogleBewertung variant="button" class="mt-8" />
      </div>
    </div>
  </section>

  {projekte.map((p) => (
    <section class="border-t border-line py-[calc(var(--section)*0.8)]">
      <div class="container-page grid gap-12 lg:grid-cols-12">
        <header class="lg:col-span-4">
          <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
            <p class="font-display text-[5rem] leading-none text-sand-400 italic lining-nums">{p.nr}</p>
            <h2 class="mt-6 text-headline">{p.titel}</h2>
            <dl class="mt-8 grid grid-cols-2 gap-4 border-y border-line py-5 text-small">
              <div><dt class="label text-olive-700">Region</dt><dd class="mt-1">{p.ort}</dd></div>
              <div><dt class="label text-olive-700">Leistung</dt><dd class="mt-1">{p.art}</dd></div>
            </dl>
            <p class="mt-8 text-ink-600">{p.text}</p>
          </div>
        </header>
        <div class="grid grid-cols-12 gap-3 md:gap-4 lg:col-span-8">
          {p.bilder.map((b) => (
            <div class:list={['overflow-hidden', b.cls]} data-reveal="image">
              <Photo src={b.src} alt={b.alt} widths={[480, 768, 1080, 1440, 1920]} sizes="(min-width: 1024px) 60vw, 100vw" class:list={['w-full object-cover', b.ratio]} />
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section bg-linen">
    <div class="container-page max-w-3xl text-center">
      <p class="label text-olive-700">Ihr Projekt</p>
      <h2 class="mt-6 text-headline">Ihre Immobilie könnte <em class="text-olive-600">die nächste sein.</em></h2>
      <p class="mt-6 text-lead text-ink-600">Ob leere Wohnung, Einfamilienhaus, Musterwohnung oder Fix &amp; Flip: Ich freue mich auf Ihr Projekt.</p>
      <a href="/kontakt" class="btn btn-primary mt-10">Projekt anfragen <Arrow /></a>
    </div>
    <div class="container-page mt-[var(--section)] max-w-5xl">
      <GoogleBewertung />
    </div>
  </section>
</Base>
