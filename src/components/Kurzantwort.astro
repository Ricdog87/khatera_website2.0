---
// Antwort zuerst: kurze, zitierfähige Zusammenfassung mit Fakten (für Featured Snippets und KI-Suchen)
interface Props {
  frage: string;
  antwort: string;
  fakten?: { label: string; wert: string }[];
  class?: string;
}
const { frage, antwort, fakten = [], class: className } = Astro.props;
---

<section class:list={['container-page', className]} aria-label="Kurz erklärt">
  <div class="grid gap-8 border-y border-ink-900/15 py-10 md:py-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="label text-olive-700">Kurz erklärt</p>
      <h2 class="mt-4 font-display text-[1.875rem] leading-tight md:text-[2.25rem]">{frage}</h2>
      <p class="mt-5 text-[1.0625rem] leading-relaxed text-ink-900/85">{antwort}</p>
    </div>
    {fakten.length > 0 && (
      <dl class="grid grid-cols-2 gap-x-6 gap-y-5 self-start lg:col-span-4 lg:col-start-9">
        {fakten.map((f) => (
          <div class="border-t border-line pt-3">
            <dt class="label text-olive-700">{f.label}</dt>
            <dd class="mt-1 font-display text-[1.375rem] leading-snug lining-nums">{f.wert}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>
