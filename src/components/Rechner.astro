---
import Arrow from './Arrow.astro';
import { rechner } from '../config/site';
---

<section class="on-dark section bg-graphit-800 text-paper" id="rechner">
  <div class="container-page grid gap-14 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-5">
      <p class="label rule text-sand-400" data-reveal>Mehrerlös-Rechner</p>
      <h2 class="mt-6 text-headline" data-reveal style="--d:1">Was steckt noch <em class="text-sand-400">in Ihrer Immobilie?</em></h2>
      <p class="mt-6 text-lead text-mist" data-reveal style="--d:2">
        Zwei Angaben, ein ehrlicher Richtwert. Sie sehen sofort, was ein Komplett-Staging ungefähr kostet und wie viel ein paar Prozent mehr Kaufpreis für Sie bedeuten.
      </p>
    </div>

    <form class="rechner grid gap-px overflow-hidden rounded-[2px] bg-white/12 lg:col-span-6 lg:col-start-7" data-reveal style="--d:1" data-min={rechner.effektMin} data-max={rechner.effektMax} data-qm-min={rechner.euroProQmMin} data-qm-max={rechner.euroProQmMax} action="/kontakt">
      <div class="grid gap-px sm:grid-cols-2">
        <label class="block bg-graphit-800 p-6">
          <span class="label text-sand-400">Angebotspreis</span>
          <span class="mt-3 flex items-baseline gap-2 border-b border-white/25 pb-2 focus-within:border-sand-400">
            <input name="preis" type="text" inputmode="numeric" autocomplete="off" value="450.000" class="w-full bg-transparent font-display text-[2.5rem] leading-none lining-nums tabular-nums outline-none" aria-describedby="rechner-hinweis" />
            <span class="font-display text-[1.75rem] text-mist">€</span>
          </span>
        </label>
        <label class="block bg-graphit-800 p-6">
          <span class="label text-sand-400">Wohnfläche</span>
          <span class="mt-3 flex items-baseline gap-2 border-b border-white/25 pb-2 focus-within:border-sand-400">
            <input name="flaeche" type="text" inputmode="numeric" autocomplete="off" value="110" class="w-full bg-transparent font-display text-[2.5rem] leading-none lining-nums tabular-nums outline-none" />
            <span class="font-display text-[1.75rem] text-mist">m²</span>
          </span>
        </label>
      </div>

      <div class="grid gap-px sm:grid-cols-2" aria-live="polite">
        <div class="bg-graphit-800 p-6">
          <p class="label text-mist">Investition Komplett-Staging, ca.</p>
          <p class="mt-3 font-display text-[2rem] leading-none lining-nums tabular-nums" data-out="kosten">3.300 – 4.950 €</p>
        </div>
        <div class="bg-graphit-800 p-6">
          <p class="label text-mist">Möglicher Mehrerlös</p>
          <p class="mt-3 font-display text-[2rem] leading-none text-sand-400 lining-nums tabular-nums" data-out="mehr">13.500 – 36.000 €</p>
        </div>
      </div>

      <div class="flex flex-col gap-5 bg-graphit-800 p-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-xs text-small text-mist">Schon <strong class="font-normal text-paper">1 % mehr</strong> sind bei Ihnen <strong class="font-normal text-paper lining-nums tabular-nums" data-out="eins">4.500 €</strong>.</p>
        <button type="submit" class="btn btn-light shrink-0">Festpreis anfragen <Arrow /></button>
      </div>
    </form>

    <p id="rechner-hinweis" class="text-[0.8125rem] text-mist lg:col-span-6 lg:col-start-7">
      Orientierungswerte, keine Garantie. Branchenangaben gehen von einem Mehrerlös zwischen {Math.round(rechner.effektMin * 100)} und {Math.round(rechner.effektMax * 100)} % aus, abhängig von Lage, Zustand und Markt.
    </p>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('form.rechner');
  if (form) {
    const num = (v: string) => Number(v.replace(/[^\d]/g, '')) || 0;
    const fmt = (n: number) => Math.round(n).toLocaleString('de-DE');
    const round = (n: number, step: number) => Math.round(n / step) * step;
    const preis = form.querySelector<HTMLInputElement>('[name=preis]')!;
    const flaeche = form.querySelector<HTMLInputElement>('[name=flaeche]')!;
    const out = (k: string) => form.querySelector<HTMLElement>(`[data-out=${k}]`)!;
    const d = form.dataset;

    const update = () => {
      const p = num(preis.value);
      const q = num(flaeche.value);
      const kMin = round(Math.max(1490, q * Number(d.qmMin)), 50);
      const kMax = round(Math.max(2990, q * Number(d.qmMax)), 50);
      out('kosten').textContent = q ? `${fmt(kMin)} – ${fmt(kMax)} €` : '–';
      out('mehr').textContent = p ? `${fmt(round(p * Number(d.min), 500))} – ${fmt(round(p * Number(d.max), 500))} €` : '–';
      out('eins').textContent = `${fmt(p * 0.01)} €`;
    };
    const format = (el: HTMLInputElement) => {
      const n = num(el.value);
      el.value = n ? n.toLocaleString('de-DE') : '';
    };
    [preis, flaeche].forEach((el) => {
      el.addEventListener('input', () => {
        format(el);
        update();
      });
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const params = new URLSearchParams({ paket: 'komplett', preis: String(num(preis.value)), flaeche: String(num(flaeche.value)) });
      location.href = `/kontakt?${params}`;
    });
    update();
  }
</script>
