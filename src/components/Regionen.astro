---
import Arrow from './Arrow.astro';
import { orte } from '../config/site';

interface Props { exclude?: string }
const { exclude } = Astro.props;
const liste = orte.filter((o) => o.slug !== exclude);
---

<section class="section bg-linen" id="regionen">
  <div class="container-page grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="label rule text-olive-700" data-reveal>Regionen</p>
      <h2 class="mt-6 text-headline" data-reveal style="--d:1">Zu Hause im <em class="text-olive-600">Rhein-Main-Gebiet.</em></h2>
      <p class="mt-6 text-ink-600" data-reveal style="--d:2">Ich arbeite von Taunusstein aus im gesamten Rhein-Main-Gebiet. Musterwohnungen für Bauträger richte ich <a href="/musterwohnungen" class="link-line text-ink-900">bundesweit</a> ein.</p>
    </div>
    <ul class="grid border-t border-ink-900/15 md:grid-cols-2 md:gap-x-10 lg:col-span-7 lg:col-start-6">
      {liste.map((o, i) => (
        <li class="border-b border-ink-900/15" data-reveal style={`--d:${i % 4}`}>
          <a href={`/home-staging-${o.slug}`} class="ort group flex items-center justify-between gap-4 py-5">
            <span class="font-display text-[2rem] leading-none md:text-[2.25rem]">
              <span class="label block text-olive-700">Home Staging</span>{o.name}
            </span>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-ink-900/20 transition-colors duration-500 group-hover:border-olive-600 group-hover:bg-olive-600 group-hover:text-paper"><Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ort > span:first-child { transition: transform 700ms var(--ease-expo), color 500ms; }
  .ort:hover > span:first-child { transform: translateX(0.75rem); color: var(--color-olive-600); }
</style>
