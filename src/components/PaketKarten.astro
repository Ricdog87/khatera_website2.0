---
import Arrow from './Arrow.astro';
import { pakete } from '../config/site';

const euro = (n: number) => n.toLocaleString('de-DE');
---

<div class="grid gap-4 lg:grid-cols-3 lg:gap-5">
  {pakete.map((p, i) => (
    <article
      class:list={[
        'paket relative flex flex-col rounded-[2px] p-7 md:p-9',
        p.highlight ? 'on-dark bg-petrol-800 text-paper' : 'border border-line bg-paper',
      ]}
      data-reveal
      style={`--d:${i}`}
    >
      {p.highlight && <p class="label absolute top-0 right-7 -translate-y-1/2 rounded-full bg-sand-400 px-3 py-1.5 text-ink-900 md:right-9">Am häufigsten gebucht</p>}
      <p class:list={['label', p.highlight ? 'text-sand-400' : 'text-sand-700']}>0{i + 1} · {p.fuer}</p>
      <h3 class="mt-5 text-title">{p.name}</h3>
      <p class:list={['mt-2 font-display text-[1.375rem] italic leading-snug', p.highlight ? 'text-mist' : 'text-ink-600']}>{p.claim}</p>

      <div class:list={['mt-8 border-y py-6', p.highlight ? 'border-white/15' : 'border-line']}>
        {p.preisAb ? (
          <p class="flex items-baseline gap-2">
            <span class="label">ab</span>
            <span class="font-display text-[3.25rem] leading-none lining-nums tabular-nums">{euro(p.preisAb)}&nbsp;€</span>
          </p>
        ) : (
          <p class="font-display text-[2.25rem] leading-none">Auf Anfrage</p>
        )}
        <p class:list={['mt-2 text-small', p.highlight ? 'text-mist' : 'text-ink-600']}>{p.preisHinweis} · zzgl. MwSt.</p>
      </div>

      <ul class="mt-7 flex-1 space-y-3 text-[1rem] leading-relaxed">
        {p.leistungen.map((l) => (
          <li class="flex gap-3">
            <svg class:list={['mt-[0.45em] h-3 w-3 shrink-0', p.highlight ? 'text-sand-400' : 'text-petrol-500']} viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6.5 4.5 10 11 2" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
            <span class={p.highlight ? 'text-paper/90' : 'text-ink-900/85'}>{l}</span>
          </li>
        ))}
      </ul>

      <a href={`/kontakt?paket=${p.id}`} class:list={['btn mt-9 w-full', p.highlight ? 'btn-light' : 'btn-dark']}>
        {p.name} anfragen <Arrow />
      </a>
    </article>
  ))}
</div>
