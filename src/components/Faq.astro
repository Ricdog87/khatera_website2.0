---
import SectionHead from './SectionHead.astro';
import type { Frage } from '../content/faq';

interface Props {
  fragen: Frage[];
  title?: string;
  em?: string;
}
const { fragen, title = 'Was Kunden', em = 'vorher wissen wollen.' } = Astro.props;
---

<section class="section" id="faq">
  <div class="container-page grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <SectionHead label="Häufige Fragen" title={title} em={em} />
      <p class="mt-8 text-ink-600" data-reveal>Ihre Frage ist nicht dabei? <a href="/kontakt" class="link-line text-ink-900">Schreiben Sie mir.</a></p>
    </div>
    <div class="border-t border-line lg:col-span-7 lg:col-start-6">
      {fragen.map((f) => (
        <details class="faq group border-b border-line" data-reveal>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 font-display text-[1.5rem] leading-snug md:text-[1.75rem]">
            {f.frage}
            <span class="relative mt-3 block h-3 w-3 shrink-0" aria-hidden="true">
              <span class="absolute inset-x-0 top-1/2 h-px bg-current"></span>
              <span class="absolute inset-y-0 left-1/2 w-px bg-current transition-transform duration-500 group-open:rotate-90"></span>
            </span>
          </summary>
          <p class="max-w-2xl pb-7 text-ink-600">{f.antwort}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
