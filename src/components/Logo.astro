---
// Logo als CSS-Maske: eine gecachte SVG-Datei für alle Seiten, Farbe über currentColor.
import wortmarke from '../assets/brand/kg-homestaging.svg';
import gestapelt from '../assets/brand/kg-homestaging-gestapelt.svg';
import monogramm from '../assets/brand/monogramm.svg';

interface Props {
  /** wortmarke: KG | HOMESTAGING in einer Zeile, gestapelt: KG groß über HOMESTAGING, monogramm: KG-Zeichen */
  variant?: 'wortmarke' | 'gestapelt' | 'monogramm';
  class?: string;
}
const { variant = 'wortmarke', class: className } = Astro.props;
const svg = { wortmarke, gestapelt, monogramm }[variant];
---

<span
  class:list={['logo-mask block w-full bg-current', className]}
  style={`aspect-ratio:${svg.width}/${svg.height};--logo:url(${svg.src})`}
  aria-hidden="true"
></span>

<style>
  .logo-mask {
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
</style>
