---
// Logo als CSS-Maske: eine gecachte SVG-Datei für alle Seiten, Farbe über currentColor.
import wortmarke from '../assets/brand/wortmarke.svg';
import monogramm from '../assets/brand/monogramm.svg';

interface Props {
  variant?: 'wortmarke' | 'monogramm';
  class?: string;
}
const { variant = 'wortmarke', class: className } = Astro.props;
const svg = variant === 'wortmarke' ? wortmarke : monogramm;
---

<span
  class:list={['logo-mask block w-full bg-current', className]}
  style={`aspect-ratio:${svg.width}/${svg.height};--logo:url(${svg.src})`}
  aria-hidden="true"
></span>

<style>
  .logo-mask {
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
</style>
